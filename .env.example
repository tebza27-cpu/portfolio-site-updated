# API Integration Configuration
# Copy this file to .env and fill in your actual values

# ===== TWILIO (WhatsApp) =====
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+1234567890

# ===== GOOGLE CHAT =====
# Create a webhook at https://chat.google.com/webhooks/new
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# ===== RECIPIENT CONTACT INFO =====
RECIPIENT_WHATSAPP_NUMBER=+27795510741
RECIPIENT_EMAIL=tebza27@gmail.com

# ===== SMTP EMAIL SETTINGS =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20

# ===== POSTGRES DATABASE =====
# Set this to your Render Postgres connection URL, or to the same value Render provides in the dashboard.
DATABASE_URL=postgres://username:password@hostname:port/databasename
